# .env.example
# Скопируйте этот файл в .env и заполните актуальные значения

# Ключи LLM API (в зависимости от поля provider в config/*.yaml)
# - provider: "gemini" -> используется GEMINI_API_KEY
# - provider: "api"    -> выбирается по base_url или префиксу модели (OPENROUTER_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# HUGGINGFACE_API_KEY=your_huggingface_key_here

# URL серверов Ollama (ОБЯЗАТЕЛЬНЫ только если в YAML задано provider: "ollama")
OLLAMA_STUDENT_BASE_URL=http://localhost:11434
OLLAMA_TEACHER_BASE_URL=http://localhost:11434
OLLAMA_EXTRACTION_BASE_URL=http://localhost:11434
OLLAMA_SEMANTIC_OPTIMIZATION_BASE_URL=http://localhost:11434
OLLAMA_VISUAL_EXTRACTOR_BASE_URL=http://localhost:11434

# Инфраструктура трекинга и кэширования
MLFLOW_TRACKING_URI=sqlite:///research/experiments/_runtime/mlflow.db
DSPY_CACHE_DIR=.cache/dspy

# Конфигурация LiteLLM
# Использовать локальную карту цен вместо запроса к GitHub при старте
LITELLM_LOCAL_MODEL_COST_MAP=True
