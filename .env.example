# .env.example
# Copy this file to .env and fill in your actual values

# Ollama URLs (REQUIRED if provider: "ollama" in YAML config)
OLLAMA_STUDENT_BASE_URL=http://localhost:11434
OLLAMA_TEACHER_BASE_URL=http://localhost:11434

# LLM API Keys (REQUIRED if provider: "api" in YAML config)
# System automatically selects key based on base_url or model name prefix
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# HUGGINGFACE_API_KEY=your_huggingface_key_here

# MinerU API Token
MINERU_API_TOKEN=your_mineru_api_token_here

# Infrastructure
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
DSPY_CACHE_DIR=${HOME}/.dspy_cache

# LiteLLM Configuration
# Set to True to use local cost map file instead of fetching latest prices from GitHub on startup.
# This avoids startup delays and SSL handshake timeout warnings in offline/firewalled environments.
LITELLM_LOCAL_MODEL_COST_MAP=True